> // PD1 (IronMule): in a decode step (up to 32 rows, inside CUDA graph capture as well) the matmul on `node` goes to the
> // kernel library (KG1), which converts the activations into its own fp16 copy (prep_x) before every first matmul on
> // them. The library's ironmule_kg_prepare names where the producer can write that copy itself (its scratch, under
> // PK3's key of node, graph epoch, data, rows and stream) or returns nullptr (PD1 off, no such matmul, or no room inside
> // a capture), and the producer then writes none. The values are prep_x's: saturated to +-65000, rounded to nearest;
> // prep_x's activation sums are not written, the library runs prep_x anyway for a kernel that reads them.
> typedef void * (*ironmule_kg_prepare_fn)(const void * node, unsigned long long epoch, const float * x, int64_t k,
>                                          int64_t batch, cudaStream_t stream);
> static half * ironmule_pd1_slot(const ggml_tensor * node, int64_t ncols, int64_t nrows, cudaStream_t stream) {
>     static const ironmule_kg_prepare_fn fn = [] {
>         const char * path = getenv("IRONMULE_KG_LIB");
>         void * handle = (path && *path) ? dlopen(path, RTLD_NOW | RTLD_LOCAL) : nullptr;
>         return handle ? (ironmule_kg_prepare_fn) dlsym(handle, "ironmule_kg_prepare") : (ironmule_kg_prepare_fn) nullptr;
>     }();
>     if (fn == nullptr || node->type != GGML_TYPE_F32 || !ggml_is_contiguous(node) || node->ne[2] != 1 ||
>         node->ne[3] != 1 || node->ne[0] != ncols || node->ne[1] != nrows) {
>         return nullptr;
>     }
>     return (half *) fn(node, ironmule_graph_epoch.load(std::memory_order_relaxed), (const float *) node->data, ncols,
>                        nrows, stream);
> }
> 
