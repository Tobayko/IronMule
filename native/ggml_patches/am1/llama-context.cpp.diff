> // AM1 (IronMule): with ironmule_set_argmax_only(1) a decode copies, for every output row, only the index of its
> // largest logit (computed on the backend that holds the logits, by ggml_argmax) instead of the whole row; the index
> // is written as a float into the row's first element. Callers that need probabilities leave it off (the default).
> static std::atomic<int> ironmule_argmax_flag{0};
> extern "C" LLAMA_API void ironmule_set_argmax_only(int on);
> extern "C" LLAMA_API void ironmule_set_argmax_only(int on) { ironmule_argmax_flag.store(on ? 1 : 0); }
> extern "C" LLAMA_API int ironmule_argmax_only_version(void);
> extern "C" LLAMA_API int ironmule_argmax_only_version(void) { return 1; }
> 
> static bool ironmule_argmax_rows(ggml_backend_t backend, ggml_tensor * t_logits, int64_t n_outputs, int64_t n_vocab,
>                                  float * dst) {
>     // one buffer per backend: two contexts in one process (a draft model beside the served one) keep their own
>     // instead of freeing and reallocating a shared one on every switch
>     struct am_buf { ggml_backend_buffer_t buf = nullptr; int64_t cap = 0; };
>     static std::map<ggml_backend_t, am_buf> bufs;
>     static std::mutex bufs_lock;
>     std::lock_guard<std::mutex> guard(bufs_lock);
>     am_buf & slot = bufs[backend];
>     if (slot.buf == nullptr || slot.cap < n_outputs) {
>         if (slot.buf) ggml_backend_buffer_free(slot.buf);
>         slot.cap = std::max<int64_t>(n_outputs, 8192);
>         slot.buf = ggml_backend_buft_alloc_buffer(ggml_backend_get_default_buffer_type(backend), slot.cap * sizeof(int32_t) + 64);
>         if (slot.buf == nullptr) { slot.cap = 0; return false; }
>     }
>     ggml_backend_buffer_t buf = slot.buf;
>     ggml_init_params params = { 8 * ggml_tensor_overhead() + ggml_graph_overhead_custom(8, false), nullptr, true };
>     ggml_context * ctx = ggml_init(params);
>     if (ctx == nullptr) return false;
>     // a leaf over the logits' memory: a view would pull the whole model graph into this one
>     ggml_tensor * leaf = ggml_new_tensor_2d(ctx, t_logits->type, n_vocab, n_outputs);
>     leaf->buffer = t_logits->buffer;
>     leaf->data = t_logits->data;
>     if (leaf->buffer == nullptr || leaf->data == nullptr) { ggml_free(ctx); return false; }
>     ggml_tensor * am = ggml_argmax(ctx, leaf);
>     am->buffer = buf;
>     am->data = ggml_backend_buffer_get_base(buf);
>     ggml_cgraph * gf = ggml_new_graph_custom(ctx, 8, false);
>     ggml_build_forward_expand(gf, am);
>     bool ok = ggml_backend_supports_op(backend, am) && ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS;
>     if (ok) {
>         std::vector<int32_t> idx(n_outputs);
>         ggml_backend_tensor_get(am, idx.data(), 0, n_outputs * sizeof(int32_t));
>         for (int64_t r = 0; r < n_outputs; r++) dst[r * n_vocab] = (float) idx[r];
>     }
>     ggml_free(ctx);
>     return ok;
> }
