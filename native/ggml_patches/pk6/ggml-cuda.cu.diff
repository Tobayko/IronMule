> // PK3's miss: a skipped tensor's f32 values were never written
> static void ironmule_pk6_check_miss(const ggml_tensor * src1, const void * data, unsigned long long epoch) {
>     const int n = ironmule_pk6_n < 256 ? (int) ironmule_pk6_n : 256;
>     for (int k = 0; k < n; k++) {
>         const ironmule_pk6_skip & s = ironmule_pk6_skipped[k];
>         if (s.node == (const void *) src1 && s.data == data && s.epoch == epoch) {
>             GGML_ABORT("PK6: a matmul missed the fp16 copy of %s, whose f32 values were not written", src1->name);
>         }
>     }
> }
