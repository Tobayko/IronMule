> // PK4 (IronMule): when the next matmul on `node` will take the cuBLAS path (a prompt step of at least the PK2 row
> // threshold), its producer writes the fp16 copy itself into PK3's slot under PK3's key (node, data, size, graph epoch),
> // so the matmul finds it and no conversion kernel runs. The values are __float2half of the same floats the
> // conversion would read. Outside CUDA graph capture only; IRONMULE_PK4=0 turns it off.
> static half * ironmule_pk4_slot(const ggml_tensor * node, int64_t nrows, size_t ne, cudaStream_t stream) {
>     static const bool on = getenv("IRONMULE_PK4") == nullptr || atoi(getenv("IRONMULE_PK4")) != 0;
>     if (!on || !ironmule_pk3_on() || ironmule_pk2_min_rows() <= 0 || nrows < ironmule_pk2_min_rows()) {
>         return nullptr;
>     }
>     cudaStreamCaptureStatus capture = cudaStreamCaptureStatusNone;
>     CUDA_CHECK(cudaStreamIsCapturing(stream, &capture));
>     if (capture != cudaStreamCaptureStatusNone) {
>         return nullptr;
>     }
>     ironmule_f16_copy & c = ironmule_pk3_copy[ggml_cuda_get_device()];
>     if (c.cap < ne) {
>         if (c.buf != nullptr) {
>             CUDA_CHECK(cudaStreamSynchronize(stream));
>             CUDA_CHECK(cudaFree(c.buf));
>         }
>         CUDA_CHECK(cudaMalloc((void **) &c.buf, ne*sizeof(half)));
>         c.cap = ne;
>     }
>     c.node = node; c.data = node->data; c.ne = ne;
>     c.epoch = ironmule_graph_epoch.load(std::memory_order_relaxed);
>     return c.buf;
> }
