> // EM1 (IronMule): rows of Q4_K and Q6_K matrices, so that a GGUF's token embedding can stay on the GPU and a decode step
> // needs no CPU work. The arithmetic is convert.cu's dequantize_block_q4_K / q6_K, element for element; one block of
> // threads per (output row, super-block).
> static __device__ __forceinline__ void em1_scale_min_k4(int j, const uint8_t * q, uint8_t & d, uint8_t & m) {
>     if (j < 4) {
>         d = q[j] & 63; m = q[j + 4] & 63;
>     } else {
>         d = (q[j+4] & 0xF) | ((q[j-4] >> 6) << 4);
>         m = (q[j+4] >>  4) | ((q[j-0] >> 6) << 4);
>     }
> }
> 
> template<typename dst_t>
> static __global__ void k_get_rows_q4_K(
>         const void * __restrict__ src0, const int32_t * __restrict__ src1, dst_t * __restrict__ dst,
>         const int64_t ne12, const size_t s1, const size_t s2, const size_t s3,
>         const size_t nb01, const size_t nb02, const size_t nb03,
>         const size_t s10, const size_t s11, const size_t s12) {
>     const int64_t i10 = blockIdx.x;
>     const int64_t ib  = blockIdx.y;
>     const int64_t i11 = blockIdx.z / ne12;
>     const int64_t i12 = blockIdx.z % ne12;
>     const int64_t i01 = src1[i10*s10 + i11*s11 + i12*s12];
>     const block_q4_K * x = (const block_q4_K *) ((const char *) src0 + i01*nb01 + i11*nb02 + i12*nb03) + ib;
> 
>     // 32 threads, as dequantize_block_q4_K
>     const int64_t tid = threadIdx.x;
>     const int64_t il  = tid/8;
>     const int64_t ir  = tid%8;
>     const int64_t is  = 2*il;
>     const int64_t n   = 4;
> 
>     dst_t * y = dst + i10*s1 + i11*s2 + i12*s3 + ib*QK_K + 64*il + n*ir;
> 
>     const float dall = __low2half(x->dm);
>     const float dmin = __high2half(x->dm);
> 
>     const uint8_t * q = x->qs + 32*il + n*ir;
> 
>     uint8_t sc, m;
>     em1_scale_min_k4(is + 0, x->scales, sc, m);
>     const float d1 = dall * sc; const float m1 = dmin * m;
>     em1_scale_min_k4(is + 1, x->scales, sc, m);
>     const float d2 = dall * sc; const float m2 = dmin * m;
>     for (int l = 0; l < n; ++l) {
>         y[l + 0] = ggml_cuda_cast<dst_t>(d1 * (q[l] & 0xF) - m1);
>         y[l +32] = ggml_cuda_cast<dst_t>(d2 * (q[l] >>  4) - m2);
>     }
> }
> 
> template<typename dst_t>
> static __global__ void k_get_rows_q6_K(
>         const void * __restrict__ src0, const int32_t * __restrict__ src1, dst_t * __restrict__ dst,
>         const int64_t ne12, const size_t s1, const size_t s2, const size_t s3,
>         const size_t nb01, const size_t nb02, const size_t nb03,
>         const size_t s10, const size_t s11, const size_t s12) {
>     const int64_t i10 = blockIdx.x;
>     const int64_t ib  = blockIdx.y;
>     const int64_t i11 = blockIdx.z / ne12;
>     const int64_t i12 = blockIdx.z % ne12;
>     const int64_t i01 = src1[i10*s10 + i11*s11 + i12*s12];
>     const block_q6_K * x = (const block_q6_K *) ((const char *) src0 + i01*nb01 + i11*nb02 + i12*nb03) + ib;
> 
>     // 64 threads, as dequantize_block_q6_K
>     const int64_t tid = threadIdx.x;
>     const int64_t ip  = tid/32;
>     const int64_t il  = tid - 32*ip;
>     const int64_t is  = 8*ip + il/16;
> 
>     dst_t * y = dst + i10*s1 + i11*s2 + i12*s3 + ib*QK_K + 128*ip + il;
> 
>     const float d = x->d;
> 
>     const uint8_t * ql = x->ql + 64*ip + il;
>     const uint8_t   qh = x->qh[32*ip + il];
>     const int8_t  * sc = x->scales + is;
> 
>     y[ 0] = ggml_cuda_cast<dst_t>(d * sc[0] * ((int8_t)((ql[ 0] & 0xF) | (((qh >> 0) & 3) << 4)) - 32));
>     y[32] = ggml_cuda_cast<dst_t>(d * sc[2] * ((int8_t)((ql[32] & 0xF) | (((qh >> 2) & 3) << 4)) - 32));
>     y[64] = ggml_cuda_cast<dst_t>(d * sc[4] * ((int8_t)((ql[ 0]  >> 4) | (((qh >> 4) & 3) << 4)) - 32));
>     y[96] = ggml_cuda_cast<dst_t>(d * sc[6] * ((int8_t)((ql[32]  >> 4) | (((qh >> 6) & 3) << 4)) - 32));
> }
