>     const ggml_tensor * w = mul->src[0] == norm ? mul->src[1] : mul->src[0];
>     if (w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w) || w->ne[1] != 1 || w->ne[2] != 1 || w->ne[3] != 1 ||
>         w->ne[0] != add->ne[0]) {
>         return false;
>     }
>     float eps = 0.0f;
>     memcpy(&eps, norm->op_params, sizeof(float));
>     const int ncols = (int) add->ne[0];
>     const int nrows = (int) add->ne[1];
>     cudaStream_t stream = ctx.stream();
>     if (ncols < 1024) {
>         ironmule_add_rms_norm_mul_f32<WARP_SIZE><<<nrows, WARP_SIZE, 0, stream>>>(
>             (const float *) x->data, (const float *) y->data, (float *) add->data, (float *) mul->data,
>             (const float *) w->data, ncols, (int) w->ne[0], eps);
>     } else {
>         ironmule_add_rms_norm_mul_f32<1024><<<nrows, 1024, 0, stream>>>(
>             (const float *) x->data, (const float *) y->data, (float *) add->data, (float *) mul->data,
>             (const float *) w->data, ncols, (int) w->ne[0], eps);
>     }
>     return true;
> }
