+static std::atomic<uint64_t> ironmule_large_prefill_cublas_dispatches{0};
+
+// An opt-in, per-process shared counter lets the HTTP benchmark observe dispatch in its worker.
+static uint64_t * ironmule_map_prefill_counter() {
+    const char * dir = std::getenv("IRONMULE_CUBLAS_COUNTER_DIR");
+    if (dir == nullptr || !*dir) return nullptr;
+    const std::string name = std::string(dir) + "/worker-" + std::to_string(getpid()) + ".bin";
+    const int fd = open(name.c_str(), O_CLOEXEC | O_RDWR | O_CREAT | O_EXCL, 0600);
+    if (fd < 0) return nullptr;
+    void * mapped = MAP_FAILED;
+    if (ftruncate(fd, sizeof(uint64_t)) == 0) {
+        mapped = mmap(nullptr, sizeof(uint64_t), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    }
+    close(fd);
+    return mapped == MAP_FAILED ? nullptr : static_cast<uint64_t *>(mapped);
+}
+
+static void ironmule_note_large_prefill() {
+    static uint64_t * const published = ironmule_map_prefill_counter();
+    ironmule_large_prefill_cublas_dispatches.fetch_add(1, std::memory_order_relaxed);
+    if (published) __atomic_fetch_add(published, uint64_t(1), __ATOMIC_RELAXED);
+}
+
+extern "C" GGML_BACKEND_API uint64_t ironmule_large_prefill_dispatch_count();
+extern "C" GGML_BACKEND_API uint64_t ironmule_large_prefill_dispatch_count() {
+    return ironmule_large_prefill_cublas_dispatches.load(std::memory_order_relaxed);
+}
