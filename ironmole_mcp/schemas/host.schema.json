{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "ironmole-host.v1"
    },
    "principal": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "allowedTools": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "repo.search",
          "repo.read"
        ]
      }
    },
    "repositories": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "allowedPaths": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "concurrency": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 4
              }
            ]
          }
        },
        "required": [
          "id",
          "root",
          "allowedPaths",
          "concurrency"
        ],
        "additionalProperties": false
      }
    },
    "objective": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "const": "latency"
            },
            "costLimitUsd": {
              "type": "number",
              "minimum": 0
            },
            "expectedUses": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "primary",
            "costLimitUsd",
            "expectedUses"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "const": "cost"
            },
            "latencyLimitMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "expectedUses": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "primary",
            "latencyLimitMs",
            "expectedUses"
          ],
          "additionalProperties": false
        }
      ]
    },
    "adaptive": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "principal",
    "policyVersion",
    "enabled",
    "expiresAt",
    "allowedTools",
    "repositories",
    "objective",
    "adaptive"
  ],
  "additionalProperties": false
}
