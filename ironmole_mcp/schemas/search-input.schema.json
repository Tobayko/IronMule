{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "repositoryId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "searchSemantics": {
      "type": "string",
      "const": "literal_case_sensitive_line.v1"
    },
    "pathFilters": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": [
    "repositoryId",
    "snapshotId",
    "query",
    "searchSemantics",
    "pathFilters",
    "offset",
    "limit"
  ],
  "additionalProperties": false
}
