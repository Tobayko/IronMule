{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "taskType": {
      "type": "string",
      "const": "repository_context_bundle.v1"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "searchSemantics": {
      "type": "string",
      "const": "literal_case_sensitive_line.v1"
    },
    "pathFilters": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "contextLines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "maxMatches": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "outputBudgetBytes": {
      "type": "integer",
      "minimum": 4096,
      "maximum": 1048576
    },
    "continuation": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "taskType",
    "repositoryId",
    "snapshotId",
    "query",
    "searchSemantics",
    "pathFilters",
    "contextLines",
    "maxMatches",
    "outputBudgetBytes",
    "continuation"
  ],
  "additionalProperties": false
}
