{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "startLine": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "endLine": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "fileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "maxLength": 2000000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "totalLines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "path",
    "startLine",
    "endLine",
    "fileSha256",
    "snapshotId",
    "text",
    "sha256",
    "totalLines"
  ],
  "additionalProperties": false
}
